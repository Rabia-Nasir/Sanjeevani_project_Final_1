# ==============================================================================
# Sanjeevani AI / CanSupport AI - Environment Configuration Example
# Copy this file to .env and configure values for your deployment environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PATIENT CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Sanjeevani AI - Multimodal Affective Engine"
VERSION="2.1.0"
ENVIRONMENT="production"                    # development | staging | production
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Security & Access Control
# Key used to authenticate counselor escalation endpoints (Header: X-Counsellor-Key)
COUNSELLOR_AUTH_KEY="your-secure-counsellor-access-key-here"

# CORS Configuration (JSON array of allowed origins)
# Example for production: ["https://portal.sanjeevani-lifebeyondcancer.com"]
CORS_ORIGINS=["*"]

# Audio Ingestion & Durational Safety Limits
MAX_AUDIO_SIZE_BYTES=15728640               # 15 MB maximum payload
MAX_AUDIO_DURATION_SEC=60.0                 # 60 seconds maximum duration
MIN_AUDIO_DURATION_SEC=0.35                 # 0.35 seconds minimum speech duration
TARGET_SAMPLE_RATE=16000                    # Mono 16 kHz

# Optional LLM API Key (For advanced Emotion-LLaMA generative reasoning in Tab 3)
# Leave blank to use offline deterministic grounded engine
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Model Execution Mode
DEVICE="cpu"                                # cpu | cuda
